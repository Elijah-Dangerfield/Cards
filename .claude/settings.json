{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh pr *)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/validate-pr-title.sh",
            "timeout": 10,
            "statusMessage": "Checking the PR title"
          }
        ]
      }
    ]
  }
}
