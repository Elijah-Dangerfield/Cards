---
import Layout from '../layouts/Layout.astro';

const features = [
  {
    tint: 'rgba(31,158,136,.12)',
    icon: '<svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#1f9e88" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="7" r="3"></circle><circle cx="17" cy="9" r="2.4"></circle><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6"></path><path d="M15.5 14.2c2.5.3 4.5 2.4 4.5 5.3"></path></svg>',
    title: 'Play anyone, anytime',
    body: "Sit down at a public table with players around the world, day or night. There's always a game running.",
  },
  {
    tint: 'rgba(233,194,85,.16)',
    icon: '<svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#c9a63c" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12v8h16v-8"></path><path d="M12 3v13"></path><path d="M12 16l4-4M12 16l-4-4"></path></svg>',
    title: 'Poker night in your pocket',
    body: 'Start a private table and share the code. Your friends drop in from anywhere in seconds, no accounts required.',
  },
  {
    tint: 'rgba(31,158,136,.12)',
    icon: '<svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#1f9e88" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="8" width="16" height="12" rx="3"></rect><path d="M12 8V5"></path><circle cx="9" cy="14" r="1.2" fill="#1f9e88" stroke="none"></circle><circle cx="15" cy="14" r="1.2" fill="#1f9e88" stroke="none"></circle></svg>',
    title: 'Practice with bots',
    body: 'Five bots, each with a different style. Sharpen your reads and build your game with nothing at stake.',
  },
  {
    tint: 'rgba(233,194,85,.16)',
    icon: '<svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#c9a63c" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 4h12v4a6 6 0 0 1-12 0z"></path><path d="M6 6H3v1a3 3 0 0 0 3 3M18 6h3v1a3 3 0 0 1-3 3"></path><path d="M9 20h6M12 14v6"></path></svg>',
    title: 'Climb the ranks',
    body: "Earn XP and unlock achievements every hand. Level up as you play and show off how far you've come.",
  },
  {
    tint: 'rgba(31,158,136,.12)',
    icon: '<svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#1f9e88" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20V4"></path><path d="M4 20h16"></path><rect x="7" y="12" width="3" height="5"></rect><rect x="12" y="8" width="3" height="9"></rect><rect x="17" y="5" width="3" height="12"></rect></svg>',
    title: 'Track your whole game',
    body: 'Your level, your win rate, and every hand you play, all in one place, so you can watch yourself improve.',
  },
  {
    tint: 'rgba(233,194,85,.16)',
    icon: '<svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#c9a63c" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l2.5 5.5L20 9l-4 4 1 6-5-3-5 3 1-6-4-4 5.5-.5z"></path></svg>',
    title: 'No catch, ever',
    body: 'No real money, no house, no ads chasing you around. What you see is the whole game.',
  },
];

const faqs = [
  {
    q: 'Is there real money involved?',
    a: "Never. Downcard uses play chips only. Nothing you do buys or wins real currency. It's purely for fun.",
  },
  {
    q: 'Is it really free?',
    a: 'Yes. The app is free to download and play, with no ads and no rake. Optional chip packs just top up your play balance.',
  },
  {
    q: 'Do my friends need an account to join?',
    a: 'No. Share your table code and they can drop straight in. Create an account only if you want to track stats and level up.',
  },
  {
    q: 'What platforms is it on?',
    a: 'Downcard is available on iOS and Android. Grab it from the App Store or Google Play above.',
  },
];

const appStoreIcon = '<svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor"><path d="M17.05 12.5c-.02-2.3 1.88-3.4 1.96-3.46-1.07-1.56-2.73-1.78-3.32-1.8-1.41-.14-2.76.83-3.48.83-.72 0-1.82-.81-3-.79-1.54.02-2.96.9-3.75 2.28-1.6 2.78-.41 6.89 1.15 9.14.76 1.1 1.67 2.34 2.85 2.29 1.14-.05 1.57-.74 2.95-.74 1.37 0 1.76.74 2.96.71 1.22-.02 2-1.12 2.75-2.22.87-1.27 1.23-2.5 1.25-2.57-.03-.01-2.4-.92-2.42-3.66zM14.8 5.56c.63-.77 1.06-1.83.94-2.9-.91.04-2.02.61-2.67 1.37-.58.67-1.09 1.75-.95 2.78 1.02.08 2.05-.52 2.68-1.25z"></path></svg>';
const playIcon = '<svg width="24" height="26" viewBox="0 0 24 24"><path d="M3.6 2.3c-.3.3-.5.7-.5 1.3v16.8c0 .6.2 1 .5 1.3l.1.1L13 12.6v-.2L3.7 2.2l-.1.1z" fill="#4becd9"></path><path d="M16.1 15.7l-3.1-3.1v-.2l3.1-3.1.1.1 3.7 2.1c1 .6 1 1.6 0 2.2l-3.8 2.1-.1-.1z" fill="#e9c255"></path><path d="M16.2 15.6L13 12.4 3.6 21.8c.3.4.9.4 1.5.1l11.1-6.3" fill="#ea5a56"></path><path d="M16.2 9.3L5.1 3C4.5 2.7 3.9 2.7 3.6 3.1L13 12.4l3.2-3.1z" fill="#5ac68a"></path></svg>';
---

<Layout>
  <!-- HERO -->
  <div style="position:relative;overflow:hidden;background:linear-gradient(160deg,#EBD277 0%,#9ACF9C 52%,#5AC6B4 100%)">
    <svg viewBox="0 0 1440 300" width="100%" height="300" preserveAspectRatio="none" style="position:absolute;left:0;bottom:120px;opacity:.4;pointer-events:none"><path d="M-40 160 C 320 300, 640 20, 980 180 S 1560 300, 1900 120" fill="none" stroke="#fff" stroke-width="5"></path></svg>
    <div class="hero-grid pad-x" style="max-width:1200px;margin:0 auto;padding:clamp(56px,10vw,96px) 32px clamp(52px,9vw,88px);display:grid;grid-template-columns:1.05fr .95fr;gap:20px;align-items:center">
      <div style="position:relative;z-index:2">
        <div class="hero-title" style="font:900 clamp(52px,13vw,104px)/0.98 Poppins;color:#1c1a18;letter-spacing:-0.04em">Fun.<br />Simple.<br />Poker.</div>
        <div style="font:500 clamp(17px,4.5vw,24px)/1.5 Poppins;color:rgba(28,26,24,.66);margin-top:28px;max-width:460px">Downcard is poker for the group chat. Spin up a table, share a code, and play. No chips at stake, no house taking a cut.</div>
        <div style="display:flex;gap:16px;margin-top:40px;flex-wrap:wrap">
          <a href="#" style="display:flex;align-items:center;gap:12px;background:#0d0c0b;color:#F5F0E6;padding:14px 24px;border-radius:16px">
            <Fragment set:html={appStoreIcon} />
            <div style="text-align:left;line-height:1.1"><div style="font:500 12px Poppins;opacity:.8">Download on the</div><div style="font:700 20px Poppins">App Store</div></div>
          </a>
          <a href="#" style="display:flex;align-items:center;gap:12px;background:#0d0c0b;color:#F5F0E6;padding:14px 24px;border-radius:16px">
            <Fragment set:html={playIcon} />
            <div style="text-align:left;line-height:1.1"><div style="font:500 12px Poppins;opacity:.8">Get it on</div><div style="font:700 20px Poppins">Google Play</div></div>
          </a>
        </div>
      </div>
      <div class="hero-art" style="position:relative;height:640px">
        <img class="hero-phone" src="/uploads/device-ios.png" alt="Downcard on iPhone" style="position:absolute;left:-70px;top:-40px;width:820px;height:auto;animation:floaty 6s ease-in-out infinite;filter:drop-shadow(0 40px 60px rgba(0,0,0,.35))" />
      </div>
    </div>
  </div>

  <!-- ETHOS STRIP -->
  <div style="background:var(--dark);color:#F5F0E6">
    <div class="pad-x" style="max-width:1000px;margin:0 auto;padding:clamp(64px,12vw,110px) 32px;text-align:center">
      <div style="font:700 15px Poppins;letter-spacing:3px;text-transform:uppercase;color:#E9C255;margin-bottom:24px">Our ethos</div>
      <div class="ethos-title" style="font:800 clamp(30px,6.4vw,52px)/1.2 Poppins;letter-spacing:-0.03em;text-wrap:balance">Poker should be about the people, not the pot. So we built the game we wanted to play. Free, honest, and dead simple.</div>
      <div style="font:500 clamp(16px,4vw,21px)/1.6 Poppins;color:rgba(245,240,230,.6);margin-top:32px;max-width:680px;margin-left:auto;margin-right:auto">No real money changes hands. There's no house skimming a rake, no pay-to-win chips, no dark patterns nudging you to spend. Just the cards, your friends, and a good time.</div>
    </div>
  </div>

  <!-- FEATURES -->
  <div class="pad-x" style="max-width:1200px;margin:0 auto;padding:clamp(64px,12vw,110px) 32px">
    <div style="text-align:center;margin-bottom:clamp(40px,7vw,64px)">
      <div style="font:700 15px Poppins;letter-spacing:3px;text-transform:uppercase;color:#1f9e88;margin-bottom:16px">Everything you need</div>
      <div class="section-title" style="font:800 clamp(30px,6vw,46px) Poppins;letter-spacing:-0.03em">Built for poker night, anywhere</div>
    </div>
    <div class="features-grid" style="display:grid;grid-template-columns:repeat(3,1fr);gap:24px">
      {features.map((f) => (
        <div style="background:var(--panel);border:1px solid var(--line);border-radius:24px;padding:clamp(26px,6vw,36px)">
          <div style={`width:56px;height:56px;border-radius:16px;background:${f.tint};display:flex;align-items:center;justify-content:center;margin-bottom:24px`}>
            <Fragment set:html={f.icon} />
          </div>
          <div style="font:700 23px Poppins;margin-bottom:10px">{f.title}</div>
          <div style="font:500 17px/1.55 Poppins;color:var(--muted)">{f.body}</div>
        </div>
      ))}
    </div>
  </div>

  <!-- SCREENSHOTS -->
  <div style="background:var(--soft);border-top:1px solid var(--line);border-bottom:1px solid var(--line)">
    <div class="pad-x" style="max-width:1200px;margin:0 auto;padding:clamp(60px,11vw,100px) 32px;text-align:center">
      <div class="section-title" style="font:800 clamp(30px,6vw,46px) Poppins;letter-spacing:-0.03em;margin-bottom:16px">A table that feels like home</div>
      <div style="font:500 clamp(16px,4vw,20px)/1.6 Poppins;color:var(--muted);max-width:600px;margin:0 auto 56px">Clean, modern, and easy to read at a glance, so nothing gets between you and the hand.</div>
      <img src="/uploads/device-android.png" alt="Downcard on Android" style="width:100%;max-width:1000px;height:auto;filter:drop-shadow(0 30px 50px rgba(0,0,0,.22))" />
    </div>
  </div>

  <!-- DOWNLOAD CTA -->
  <div class="pad-x" style="max-width:1200px;margin:0 auto;padding:clamp(64px,12vw,110px) 32px">
    <div style="background:var(--dark);border-radius:clamp(24px,5vw,32px);padding:clamp(44px,9vw,80px) clamp(24px,6vw,72px);text-align:center">
      <div class="section-title" style="font:800 clamp(30px,6vw,46px)/1.1 Poppins;color:#F5F0E6;letter-spacing:-0.03em">Ready to deal?</div>
      <div style="font:500 clamp(16px,4vw,20px)/1.6 Poppins;color:rgba(245,240,230,.62);margin-top:20px;max-width:520px;margin-left:auto;margin-right:auto">Download Downcard, start a table, and share the code. Your first hand is a minute away.</div>
      <div style="display:flex;gap:16px;justify-content:center;margin-top:40px;flex-wrap:wrap">
        <a href="#" style="display:flex;align-items:center;gap:12px;background:#F5F0E6;color:#0d0c0b;padding:14px 24px;border-radius:16px">
          <Fragment set:html={appStoreIcon} />
          <div style="text-align:left;line-height:1.1"><div style="font:500 12px Poppins;opacity:.7">Download on the</div><div style="font:700 20px Poppins">App Store</div></div>
        </a>
        <a href="#" style="display:flex;align-items:center;gap:12px;background:#F5F0E6;color:#0d0c0b;padding:14px 24px;border-radius:16px">
          <Fragment set:html={playIcon} />
          <div style="text-align:left;line-height:1.1"><div style="font:500 12px Poppins;opacity:.7">Get it on</div><div style="font:700 20px Poppins">Google Play</div></div>
        </a>
      </div>
    </div>
  </div>

  <!-- FAQ -->
  <div class="pad-x" style="max-width:820px;margin:0 auto;padding:0 32px clamp(64px,12vw,110px)">
    <div style="text-align:center;margin-bottom:clamp(36px,6vw,56px)"><div class="section-title" style="font:800 clamp(30px,6vw,46px) Poppins;letter-spacing:-0.03em">Questions</div></div>
    <div style="display:flex;flex-direction:column;gap:16px">
      {faqs.map((f) => (
        <div style="background:var(--panel);border:1px solid var(--line);border-radius:20px;padding:28px 32px">
          <div style="font:700 20px Poppins;margin-bottom:8px">{f.q}</div>
          <div style="font:500 17px/1.55 Poppins;color:var(--muted)">{f.a}</div>
        </div>
      ))}
    </div>
  </div>
</Layout>
