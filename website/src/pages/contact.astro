---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.astro';
---

<Layout title="Contact — Downcard" description="Get in touch with the Downcard team.">
  <div class="pad-x" style="max-width:1000px;margin:0 auto;padding:clamp(48px,10vw,72px) 32px clamp(72px,12vw,110px)">
    <div style="font:800 clamp(34px,8vw,52px) Poppins;letter-spacing:-0.03em;margin-bottom:12px">Get in touch</div>
    <div style="font:500 clamp(16px,4vw,20px)/1.6 Poppins;color:var(--muted);max-width:560px;margin-bottom:56px">Bug reports, feature ideas, or just want to say hi? We read everything.</div>

    <div class="contact-grid" style="display:grid;grid-template-columns:1fr 1fr;gap:20px">
      <a href="mailto:contact@downcard.app" style="background:var(--panel);border:1px solid var(--line);border-radius:22px;padding:32px;display:block">
        <div style="width:52px;height:52px;border-radius:14px;background:rgba(31,158,136,.12);display:flex;align-items:center;justify-content:center;margin-bottom:20px"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#1f9e88" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="3"></rect><path d="M4 7l8 6 8-6"></path></svg></div>
        <div style="font:700 21px Poppins;margin-bottom:6px">Email us</div>
        <div style="font:600 17px Poppins;color:#1f9e88">contact@downcard.app</div>
      </a>
      <div style="background:var(--panel);border:1px solid var(--line);border-radius:22px;padding:32px">
        <div style="width:52px;height:52px;border-radius:14px;background:rgba(233,194,85,.16);display:flex;align-items:center;justify-content:center;margin-bottom:20px"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#c9a63c" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg></div>
        <div style="font:700 21px Poppins;margin-bottom:6px">Quick replies</div>
        <div style="font:600 17px Poppins;color:var(--muted)">We usually get back within a day.</div>
      </div>
    </div>

    <ContactForm />
  </div>
</Layout>
