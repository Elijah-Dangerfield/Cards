---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Downcard — Fun. Simple. Poker.',
  description = 'Downcard is poker for the group chat. Spin up a table, share a code, and play. No real money, no house, no catch.',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/uploads/app-icon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<script>
  // Someone who arrives from a tagged ad link (?c=...) and then taps a store
  // button should still be counted for that campaign, on any page they reach.
  import { APP_STORE_URL, PLAY_STORE_URL, appStoreUrl, playStoreUrl, readCampaign } from '../lib/store-links';

  const KEY = 'downcard.campaign';
  let search = location.search;
  try {
    if (readCampaign(search)) sessionStorage.setItem(KEY, search);
    else search = sessionStorage.getItem(KEY) ?? '';
  } catch {
    // Storage can be off in some in-app browsers; the current URL still works.
  }
  const tag = readCampaign(search);
  if (tag) {
    for (const link of document.querySelectorAll<HTMLAnchorElement>('a[href]')) {
      if (link.href.startsWith(APP_STORE_URL)) link.href = appStoreUrl(tag);
      else if (link.href.startsWith(PLAY_STORE_URL)) link.href = playStoreUrl(tag);
    }
  }
</script>
