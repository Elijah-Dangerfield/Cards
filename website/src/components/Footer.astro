---
const year = new Date().getFullYear();
---

<div style="background:var(--dark);color:#F5F0E6">
  <div class="pad-x" style="max-width:1200px;margin:0 auto;padding:64px 32px 48px">
    <div style="display:flex;justify-content:space-between;gap:40px;flex-wrap:wrap;margin-bottom:48px">
      <div style="max-width:320px">
        <div style="display:flex;align-items:center;gap:12px;margin-bottom:18px">
          <img src="/uploads/app-icon.png" alt="Downcard" style="width:42px;height:42px;object-fit:contain;margin:-4px 0" />
          <span style="font:800 22px Poppins">Downcard</span>
        </div>
        <div style="font:500 16px/1.6 Poppins;color:rgba(245,240,230,.55)">Fun, simple, free poker for you and your friends. No real money. No house. No catch.</div>
      </div>
      <div style="display:flex;gap:64px;flex-wrap:wrap">
        <div style="display:flex;flex-direction:column;gap:12px">
          <div style="font:700 14px Poppins;letter-spacing:1px;text-transform:uppercase;color:rgba(245,240,230,.4);margin-bottom:4px">Product</div>
          <a href="/" style="font:500 16px Poppins;color:rgba(245,240,230,.75)">Home</a>
          <a href="#" style="font:500 16px Poppins;color:rgba(245,240,230,.75)">App Store</a>
          <a href="#" style="font:500 16px Poppins;color:rgba(245,240,230,.75)">Google Play</a>
        </div>
        <div style="display:flex;flex-direction:column;gap:12px">
          <div style="font:700 14px Poppins;letter-spacing:1px;text-transform:uppercase;color:rgba(245,240,230,.4);margin-bottom:4px">Legal & help</div>
          <a href="/support" style="font:500 16px Poppins;color:rgba(245,240,230,.75)">Support</a>
          <a href="/terms" style="font:500 16px Poppins;color:rgba(245,240,230,.75)">Terms of Service</a>
          <a href="/privacy" style="font:500 16px Poppins;color:rgba(245,240,230,.75)">Privacy Policy</a>
          <a href="/contact" style="font:500 16px Poppins;color:rgba(245,240,230,.75)">Contact</a>
        </div>
      </div>
    </div>
    <div style="border-top:1px solid rgba(245,240,230,.12);padding-top:28px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px">
      <div style="font:500 15px Poppins;color:rgba(245,240,230,.45)">© {year} Downcard. All rights reserved.</div>
      <div style="font:500 15px Poppins;color:rgba(245,240,230,.45)">Made for the group chat.</div>
    </div>
  </div>
</div>
