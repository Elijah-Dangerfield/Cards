---
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  { href: '/', label: 'Home' },
  { href: '/support', label: 'Support' },
  { href: '/terms', label: 'Terms' },
  { href: '/privacy', label: 'Privacy' },
  { href: '/contact', label: 'Contact' },
];
---

<div style="position:sticky;top:0;z-index:100;backdrop-filter:blur(14px);background:color-mix(in srgb,var(--bg) 82%,transparent);border-bottom:1px solid var(--line)">
  <div class="nav-inner" style="max-width:1200px;margin:0 auto;padding:18px 32px;display:flex;align-items:center;justify-content:space-between;gap:24px">
    <a href="/" style="display:flex;align-items:center;gap:8px">
      <img src="/uploads/app-icon.png" alt="Downcard" style="width:48px;height:48px;object-fit:contain;margin:-6px 0" />
      <span style="font:800 24px Poppins;letter-spacing:-1px">Downcard</span>
    </a>
    <div class="nav-links" style="display:flex;align-items:center;gap:8px">
      {links.map(({ href, label }) => {
        const active = path === href;
        return (
          <a href={href} style={`position:relative;padding:8px 16px;font:600 16px Poppins;color:${active ? 'var(--ink)' : 'var(--muted)'}`}>
            {label}
            {active && <div style="position:absolute;left:16px;right:16px;bottom:0;height:3px;border-radius:3px;background:#1f9e88"></div>}
          </a>
        );
      })}
    </div>
  </div>
</div>
