      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome,reason) (count_over_time({service_name=\"cards-client\", deployment_environment=\"__ENV__\"} | event_name=\"standing_table.operation_completed\" | operation=\"create\" [1h]))",
          "queryType": "range",
          "range": true,
          "legendFormat": "{{operation}} {{outcome}} {{reason}} {{surface}} {{result}} {{platform}}"
        }
