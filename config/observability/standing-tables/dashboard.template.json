{
  "uid": "dc-standing-tables",
  "title": "Standing Tables Health",
  "description": "Prepared offline. Fixed environment __ENV__. Rolling 1h windows for client and server. No events while flags are off is expected; missing traffic does not establish health. Client events can be sampled, delayed or duplicated; server requests include bots. Metric names and resource selectors require ingestion verification before activation.",
  "tags": [
    "downcard",
    "standing-tables",
    "prepared-offline"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Client operations by outcome",
      "description": "Per repository call, including background mine refreshes after writes. Separate write success from refresh failure. Rolling 1h windows; counts overlap between samples.",
      "datasource": {
        "type": "loki",
        "uid": "__LOKI_UID__"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (operation,outcome,reason) (count_over_time({service_name=\"cards-client\", deployment_environment=\"__ENV__\"} | event_name=\"standing_table.operation_completed\" [1h]))",
          "queryType": "range",
          "range": true,
          "legendFormat": "{{operation}} {{outcome}} {{reason}} {{surface}} {{result}} {{platform}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Create outcomes",
      "description": "Terminal create repository calls. UI create_started counts entry intent and is not a request denominator. Rolling 1h windows; counts overlap between samples.",
      "datasource": {
        "type": "loki",
        "uid": "__LOKI_UID__"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
