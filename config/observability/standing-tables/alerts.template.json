            "severity": "warning",
            "feature": "standing_tables",
            "environment": "__ENV__"
          },
          "annotations": {
            "summary": "Standing table creation failing",
            "description": "Create calls that ended in a network, server, decode or unknown failure. Chooser abandonment and business refusals are excluded. Fires at 2 or more in a rolling 6h and persists 5m. Quiet or absent traffic does not alert; query execution errors remain errors. Verify ingestion separately before activation.",
            "__dashboardUid__": "dc-standing-tables",
            "__panelId__": "24"
