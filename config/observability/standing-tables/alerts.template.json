{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "Standing tables health",
      "folder": "Downcard - Engineering",
      "interval": "1m",
      "rules": [
        {
          "uid": "st-client-errors",
          "title": "Standing table client operations failing",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "queryType": "instant",
              "relativeTimeRange": {
                "from": 3600,
                "to": 0
              },
              "datasourceUid": "__LOKI_UID__",
              "model": {
                "refId": "A",
                "expr": "(100 * ((sum(count_over_time({service_name=\"cards-client\", deployment_environment=\"__ENV__\"} | event_name=\"standing_table.operation_completed\" | outcome=\"failure\" | reason=~\"network|server|decode\" [1h]))) or (0 * ((sum(count_over_time({service_name=\"cards-client\", deployment_environment=\"__ENV__\"} | event_name=\"standing_table.operation_completed\" [1h]))) > 0))) / ((sum(count_over_time({service_name=\"cards-client\", deployment_environment=\"__ENV__\"} | event_name=\"standing_table.operation_completed\" [1h]))) > 0) > bool 20) * ((sum(count_over_time({service_name=\"cards-client\", deployment_environment=\"__ENV__\"} | event_name=\"standing_table.operation_completed\" [1h]))) >= bool 20)",
                "instant": true,
                "queryType": "instant",
                "intervalMs": 60000,
                "maxDataPoints": 1
              }
            },
            {
              "refId": "C",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    },
                    "operator": {
                      "type": "and"
                    },
                    "query": {
                      "params": [
                        "C"
                      ]
                    },
                    "reducer": {
                      "type": "last",
                      "params": []
                    },
                    "type": "query"
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "10m",
          "isPaused": true,
          "labels": {
            "severity": "warning",
            "feature": "standing_tables",
            "environment": "__ENV__"
          },
          "annotations": {
            "summary": "Standing table client operations failing",
            "description": "Unexpected transport, server or decode failures. Invalid input, conflict, auth and expected offline results excluded. Rolling 1h; fires only above 20% with at least 20 requests and persists 10m. Quiet or absent traffic does not alert; query execution errors remain errors. Verify ingestion separately before activation.",
            "__dashboardUid__": "dc-standing-tables",
            "__panelId__": "3"
          }
        },
        {
          "uid": "st-create-errors",
