{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "standing-tables-__ENV__",
      "folder": "Downcard \u2014 Engineering",
      "interval": "1m",
      "rules": [
        {
          "uid": "st-client-errors-__ENV__",
          "title": "Standing table client operations failing (__ENV__)",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "queryType": "instant",
              "relativeTimeRange": {
                "from": 21600,
                "to": 0
              },
              "datasourceUid": "__LOKI_UID__",
              "model": {
                "refId": "A",
                "expr": "(sum(count_over_time({service_name=\"cards-client\", deployment_environment=\"__ENV__\"} | event_name=\"standing_table.operation_completed\" | outcome=\"failure\" | reason=~\"network|server|decode|unknown\" [6h])) or vector(0)) >= bool 3",
                "instant": true,
                "queryType": "instant",
                "intervalMs": 60000,
                "maxDataPoints": 1
              }
            },
            {
              "refId": "C",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    },
                    "operator": {
                      "type": "and"
                    },
                    "query": {
                      "params": [
                        "C"
                      ]
                    },
                    "reducer": {
                      "type": "last",
                      "params": []
                    },
                    "type": "query"
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "5m",
          "isPaused": true,
          "labels": {
            "severity": "warning",
            "feature": "standing_tables",
            "environment": "__ENV__"
          },
          "annotations": {
            "summary": "Standing table client operations failing",
            "description": "Network, server, decode or unknown failures across all standing-table operations. Invalid input, conflict, auth and expected offline results are excluded. Fires at 3 or more in a rolling 6h and persists 5m. Quiet or absent traffic does not alert; query execution errors remain errors. Verify ingestion separately before activation.",
            "__dashboardUid__": "dc-standing-tables",
            "__panelId__": "24"
          }
        },
        {
