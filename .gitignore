*.iml
.kotlin
.gradle
# Ignore local Claude config (settings.local.json, etc.) but track shared,
# version-controlled skills + commands so they ship with the repo.
.claude/*
!.claude/skills/
!.claude/commands/
**/build/
xcuserdata
!src/**/build/
local.properties
.idea
.DS_Store
captures
.externalNativeBuild
.cxx
*.xcodeproj/*
!*.xcodeproj/project.pbxproj
!*.xcodeproj/xcshareddata/
!*.xcodeproj/project.xcworkspace/
!*.xcworkspace/contents.xcworkspacedata
**/xcshareddata/WorkspaceSettings.xcsettings
node_modules/

# Server runtime secrets. Real values live in apps/server/.env locally
# and in Fly.io secrets in production. Only .env.example is committed.
apps/server/.env
apps/server/.env.local
apps/server/.env.*.local

# Local TestFlight-build credentials (ASC API key etc.). Auto-loaded by
# fastlane; only .env.example is committed.
apps/ios/fastlane/.env
apps/ios/fastlane/.env.local

# Admin tool: local-only dev/prod admin tokens (baked into the bundle at build time)
apps/admin/admin-tokens.local.properties

# Android signing keystores. THIS REPO IS PUBLIC — a committed keystore is a
# permanent, world-readable leak of the app signing key. Keystores live outside
# the repo (~/keys + 1Password); CI reads them from the ANDROID_KEYSTORE_BASE64
# secret. Never commit one.
*.jks
*.keystore
*.p12
