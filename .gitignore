*.iml
.kotlin
.gradle
# Ignore local Claude config (settings.local.json, etc.) but track shared,
# version-controlled skills + commands so they ship with the repo.
.claude/*
!.claude/skills/
!.claude/commands/
**/build/
xcuserdata
!src/**/build/
local.properties
.idea
.DS_Store
captures
.externalNativeBuild
.cxx
*.xcodeproj/*
!*.xcodeproj/project.pbxproj
!*.xcodeproj/xcshareddata/
!*.xcodeproj/project.xcworkspace/
!*.xcworkspace/contents.xcworkspacedata
**/xcshareddata/WorkspaceSettings.xcsettings
node_modules/

# Server runtime secrets. Real values live in apps/server/.env locally
# and in Fly.io secrets in production. Only .env.example is committed.
apps/server/.env
apps/server/.env.local
apps/server/.env.*.local
