<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.dangerfield.cards.maintenance</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>NSUserNotificationsUsageDescription</key>
	<string>We'd like to send you notifications.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>processing</string>
	</array>
	<!--
	  App Transport Security exception: allow cleartext HTTP only to
	  localhost so debug builds can talk to the Ktor server running on the
	  host machine (`./gradlew :apps:server:run`).

	  Every other domain still requires HTTPS — when we deploy a dev/staging
	  API, it'll go through TLS like prod does. The mirror policy on Android
	  lives in apps/compose/src/androidMain/res/xml/network_security_config.xml.
	-->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSExceptionDomains</key>
		<dict>
			<key>localhost</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
				<key>NSIncludesSubdomains</key>
				<false/>
			</dict>
		</dict>
	</dict>
	<!--
	  Custom-scheme deep links. Today's only consumer is
	  `cards://auth/confirmed` (Supabase verify-email redirect). New routes
	  add themselves via `deepLinks =` on `screen<Route>` in the relevant
	  FeatureEntryPoint; .onOpenURL in iOSApp.swift forwards into the
	  DeepLinkBridge regardless of which path the URL targets.

	  Universal Links (https://...) require an `Associated Domains`
	  entitlement (`applinks:example.com`) plus an apple-app-site-association
	  file at https://example.com/.well-known/.
	-->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.dangerfield.cards</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>cards</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
