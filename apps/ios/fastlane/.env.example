# Local TestFlight builds: copy to `.env` (gitignored, auto-loaded by
# fastlane) and fill in. Then `bundle exec fastlane beta` from apps/ios does
# exactly what the "Beta (internal)" GitHub workflow does — build, sign, and
# upload to the TestFlight internal group — using your Mac instead of a
# hosted runner (much faster: the K/N release link swaps to death on the free
# 7GB runners). The remote flow is unaffected; this is an alternative
# trigger, not a replacement.
#
# Signing: locally the Fastfile skips the CI keychain import and uses your
# login keychain, which already holds the Apple Distribution cert.

# developer.apple.com → Membership (also the parenthetical in the
# "Apple Distribution: …" certificate name).
APPLE_TEAM_ID=

# App Store Connect → Users and Access → Integrations → App Store Connect
# API → Team Keys. Issuer ID is shown at the top of that page.
ASC_KEY_ID=
ASC_ISSUER_ID=

# The one-time-download .p8 for that key, base64'd:
#   base64 -i AuthKey_XXXXXXXXXX.p8 | pbcopy
ASC_KEY_P8_BASE64=

# Optional: dSYM upload + release tracking. Leave empty to skip (non-fatal).
# Releases-scoped org token from sentry.io → Settings → Auth Tokens.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Optional: override the TestFlight "What to Test" text for this build.
TESTFLIGHT_CHANGELOG=
