# Copy this file to apps/server/.env and fill in real values.
# .env is gitignored. Never commit real credentials.
#
# In production, set these via `fly secrets set KEY=value` instead of a file.

# ---- Database ----
#
# Postgres connection string for the Ktor server.
#
# Production / Fly.io (IPv6 supported) — use the direct Supabase host:
#   postgresql://postgres:<password>@db.<projectref>.supabase.co:5432/postgres
#
# Local dev on a typical home network (IPv4-only) — Supabase's direct host
# is IPv6-only on free tier, so use the Session Pooler instead:
#   Project Settings -> Database -> "Connection pooling" -> "Session" mode.
#   Format:
#   postgresql://postgres.<projectref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# Special characters in the password must be URL-encoded. `$` -> `%24`.
DATABASE_URL=postgresql://postgres:%3CURL-ENCODED-PASSWORD%3E@db.%3CPROJECT-REF%3E.supabase.co:5432/postgres

# Optional pool tuning. Defaults are fine for small instances.
DATABASE_POOL_MAX_SIZE=10
DATABASE_POOL_MIN_IDLE=2

# ---- Supabase Auth ----
#
# Used to verify the Supabase-issued JWTs the client sends on every
# authenticated request.
#
# Supabase signs JWTs with ES256 (asymmetric). Our server fetches the
# project's public keys from <SUPABASE_URL>/auth/v1/.well-known/jwks.json
# at runtime. No shared secret needed for verification.
SUPABASE_URL=https://<PROJECT-REF>.supabase.co

# Service-role JWT — Project Settings → API → service_role → "Reveal."
# Required for admin-gated routes: DELETE /v1/me, the orphan-anon sweep,
# any future admin lookups. The server boots without it but those routes
# respond with 503 ("delete_not_configured") until it's set.
# Treat as a root password. Never log, never expose to clients.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Server ----
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
LOG_LEVEL=INFO

# ---- Sentry (optional) ----
#
# Leave blank to disable error reporting (V1 default). The server boots
# fine without a DSN — Sentry.captureException() becomes a no-op and a
# single warning logs at startup.
#
# When you provision a Sentry project, the recommended shape is:
#   - One Sentry project for the SERVER (separate from the client project).
#   - Single project with multiple environments (dev / prod), filtered via
#     the SENTRY_ENVIRONMENT tag — easier cross-env grouping than two
#     separate projects.
#
# SENTRY_ENVIRONMENT defaults to "prod" when FLY_APP_NAME=cards-server,
# otherwise "dev" — override here if you want something else (e.g. "local").
# SENTRY_RELEASE is conventionally the git short SHA; the deploy workflow
# can set it via `fly secrets set` or as a per-deploy env override.
SENTRY_DSN=
SENTRY_ENVIRONMENT=dev
SENTRY_RELEASE=
