# Server Docker build only needs the server itself + repo-root Gradle
# scaffolding. Everything else just bloats the build context.
#
# .dockerignore is evaluated from the build-context root (the repo root),
# so paths here are repo-relative.

# Build outputs everywhere
**/build/
**/.gradle/
**/.kotlin/

# IDE
.idea/
*.iml
.vscode/

# Other apps + client-only code that doesn't ship with the server image.
# The Dockerfile explicitly COPYs the libraries the server consumes
# (libraries/{core,gameplay,bots}) via un-ignore patterns below — adding
# `libraries/` as a blanket ignore here would mask those COPYs.
apps/compose/
apps/ios/
features/
docs/
pages/
scripts/

# Ignore client-only libraries, but un-ignore the three the server actually
# consumes. If apps/server picks up a new :libraries:* dep, add a matching
# `!libraries/<name>/` line here and a COPY line in the Dockerfile. See
# apps/server/DEPLOY.md → "Server build slimming".
libraries/
!libraries/core/
!libraries/gameplay/
!libraries/bots/

# Misc
.git/
.github/
.claude/
*.log
*.DS_Store
node_modules/
local.properties

# Server's own state we don't want baked in
apps/server/.env
apps/server/build/
