    <string name="onboarding_how_card_chips_title">Chips fund the table</string>
    <string name="onboarding_how_card_chips_subtitle">Earn at play. Spend in the shop.</string>
    <string name="onboarding_how_card_league_title">Climb the league</string>
    <string name="onboarding_how_card_league_subtitle">Top 7 of 30 promote each week.</string>
    <string name="onboarding_how_continue_button">Take a seat</string>

    <!-- Room — Leave-bots confirm dialog (back-press while a hand is in progress). -->
    <string name="room_leave_bots_title">Leave the table?</string>
    <string name="room_leave_bots_body">You\'ll lose progress on this hand. Your XP and chips are saved.</string>
    <string name="room_leave_bots_stay_button">Stay</string>
    <string name="room_leave_bots_leave_button">Leave</string>

    <!-- Room — Swipe-fold confirm dialog (swipe-down to fold while in a hand). -->
    <string name="room_swipe_fold_title">Fold this hand?</string>
    <string name="room_swipe_fold_body">You\'ll forfeit the round and any chips already in the pot.</string>
    <string name="room_swipe_fold_dont_show_again">Don\'t show this again</string>
    <string name="room_swipe_fold_cancel_button">Cancel</string>
    <string name="room_swipe_fold_confirm_button">Fold</string>

    <!-- Room — Pot explainer (tap on the gold pot pill). -->
    <string name="room_pot_explainer_title">The pot</string>
    <string name="room_pot_explainer_body">Every bet and call this hand stacks into the pot. The player with the best hand at showdown wins it all.</string>

    <!-- Room — Stack explainer (tap on the human\'s own chip stack on the bot table). -->
    <string name="room_stack_explainer_title">You have %1$s chips</string>
    <string name="room_stack_explainer_body">Use them to bet, call, and raise during a hand. Chips you put in go to the pot — the player with the best hand at showdown wins it.</string>
    <string name="room_stack_explainer_practice_note">Go bust against bots and a fresh stack arrives next hand. Practice chips don\'t count for keeps.</string>

    <!-- Room — Bet-pill explainer (tap on a player\'s gold bet pill). -->
    <string name="room_bet_pill_explainer_title">%1$s put in %2$s</string>
    <string name="room_bet_pill_explainer_body">That\'s how many chips they\'ve added to the pot on this betting round. It resets when the next card hits the board.</string>

    <!-- Room — Blind-roles explainer (tap any of the D / SB / BB chips). -->
    <string name="room_blind_roles_title">Table positions</string>
    <string name="room_blind_roles_dealer_label">D</string>
    <string name="room_blind_roles_dealer_title">Dealer</string>
    <string name="room_blind_roles_dealer_description">Action moves clockwise from the player left of the dealer. The dealer position rotates each hand.</string>
    <string name="room_blind_roles_small_blind_label">SB</string>
    <string name="room_blind_roles_small_blind_title">Small blind</string>
    <string name="room_blind_roles_small_blind_description">Forced half-bet, posted by the player immediately left of the dealer before any cards are dealt.</string>
    <string name="room_blind_roles_big_blind_label">BB</string>
    <string name="room_blind_roles_big_blind_title">Big blind</string>
    <string name="room_blind_roles_big_blind_description">Forced full bet, posted left of the small blind. The minimum opening bet for the hand.</string>

    <!-- Room — Last-action explainer (tap a player\'s "Folded" / "Called 10" / etc. pill). -->
    <string name="room_last_action_headline_fold">%1$s folded</string>
    <string name="room_last_action_headline_check">%1$s checked</string>
    <string name="room_last_action_headline_call">%1$s called %2$s</string>
    <string name="room_last_action_headline_bet">%1$s bet %2$s</string>
    <string name="room_last_action_headline_raise">%1$s raised to %2$s</string>
    <string name="room_last_action_headline_all_in">%1$s went all in for %2$s</string>
    <string name="room_last_action_body_fold">Fold means giving up the hand. Any chips already in the pot stay there — they don\'t come back.</string>
    <string name="room_last_action_body_check">Check passes the action without putting any chips in. Only legal when there\'s nothing to call.</string>
    <string name="room_last_action_body_call">Call matches the current bet so they can stay in the hand. No raise, just keeping up.</string>
    <string name="room_last_action_body_bet">Bet opens the betting on this street. Everyone else now has to call, raise, or fold.</string>
    <string name="room_last_action_body_raise">Raise increases the current bet. Everyone else who wants to stay in has to match the new total.</string>
    <string name="room_last_action_body_all_in">All in means pushing their entire stack into the pot. They can\'t act again this hand.</string>
    <string name="room_last_action_cheat_sheet_hint">Tap the ? icon up top for the full list of actions.</string>

    <!-- Room — Hand-label explainer (tap the human\'s hand-label pill: "Pair", "Two pair", etc.). -->
    <string name="room_hand_label_body_royal_flush">Ten through Ace, all the same suit. The strongest hand in poker.</string>
    <string name="room_hand_label_body_straight_flush">Five cards in a row, all the same suit. Above four of a kind.</string>
    <string name="room_hand_label_body_four_of_a_kind">Four cards of the same rank. Beats every hand except a straight flush or royal flush.</string>
    <string name="room_hand_label_body_full_house">Three of a kind plus a pair. Beats a flush.</string>
    <string name="room_hand_label_body_flush">Five cards of the same suit, in any order. Beats a straight.</string>
    <string name="room_hand_label_body_straight">Five cards in a row, mixed suits. Beats three of a kind.</string>
    <string name="room_hand_label_body_three_of_a_kind">Three cards of the same rank. Beats two pair.</string>
    <string name="room_hand_label_body_two_pair">Two pairs of different ranks. Beats a single pair.</string>
    <string name="room_hand_label_body_pocket_pair">Your two hole cards are the same rank — already a pair before any community cards. Strong starting hand.</string>
    <string name="room_hand_label_body_pair">Two cards of the same rank. Beats a high card.</string>
    <string name="room_hand_label_body_high_card">No combinations — the highest single card wins. The weakest hand category.</string>
    <string name="room_hand_label_body_default">Your current hand, based on your hole cards and what\'s on the board.</string>
    <string name="room_hand_label_cheat_sheet_hint">Tap the ? icon up top for the full ranking list with examples.</string>

